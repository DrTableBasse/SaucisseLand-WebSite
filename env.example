# Database
# Utilise la base de données PostgreSQL partagée avec le bot Hermes
# Pour Docker (via réseau partagé): postgresql://saucisseland_web:web_password_2024@saucisseland-postgres:5432/saucisseland
# Pour local (sans Docker): postgresql://saucisseland_web:web_password_2024@localhost:5432/saucisseland
DATABASE_URL=postgresql://saucisseland_web:web_password_2024@saucisseland-postgres:5432/saucisseland

# Base URL (IP, nom de domaine ou localhost) - OBLIGATOIRE
# IMPORTANT: Utilisez votre IP réseau ou un FQDN pour que les autres utilisateurs puissent s'authentifier
# Si vous utilisez localhost, seul votre poste pourra s'authentifier (les autres utilisateurs pointeront vers leur propre localhost)
# Exemples: 
#   - http://192.168.1.100:8000 (pour accès réseau local - RECOMMANDÉ)
#   - http://10.201.20.12:8000 (exemple avec IP réseau)
#   - http://example.com (pour nom de domaine)
#   - http://localhost:8000 (uniquement pour développement local, ne fonctionnera pas pour les autres utilisateurs)
BASE_URL=http://192.168.1.100:8000

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# DISCORD_REDIRECT_URI sera construit automatiquement depuis BASE_URL si non défini
# Format: {BASE_URL}/api/auth/callback/social/discord
# Exemple: http://192.168.1.100:8000/api/auth/callback/social/discord
# IMPORTANT: Vous DEVEZ ajouter cette URL dans Discord Developer Portal (OAuth2 → Redirects)
# Si vous voulez définir manuellement, décommentez la ligne suivante:
# DISCORD_REDIRECT_URI=http://192.168.1.100:8000/api/auth/callback/social/discord
DISCORD_GUILD_ID=1280110865852399687
DISCORD_BOT_TOKEN=your_discord_bot_token

# Allowed role IDs (comma-separated list)
# Exemple: ALLOWED_ROLE_IDS=123456789012345678,987654321098765432
ALLOWED_ROLE_IDS=

# Secret key for sessions (generate with: python backend/generate_secret.py)
SECRET_KEY=your_secret_key_here

# CORS Origins (comma-separated, optionnel - utilise BASE_URL par défaut)
# Exemples: http://192.168.1.100:8000,http://example.com,http://localhost:8000
# CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ========================================
# CONFIGURATION API HERMES BOT
# ========================================
# URL de l'API Hermes (bot Discord)
# Exemple: http://localhost:8001 ou http://192.168.1.100:8001
HERMES_API_URL=http://localhost:8001

# Token d'authentification pour l'API Hermes
# Doit correspondre à API_TOKEN dans le .env du bot Hermes
HERMES_API_TOKEN=your_hermes_api_token_here

# URL du backend FastAPI (pour récupérer l'ID Discord de l'utilisateur)
# Exemple: http://localhost:8000 ou http://192.168.1.100:8000
BACKEND_API_URL=http://localhost:8000

